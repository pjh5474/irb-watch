# Which settings file to load: APP_ENV=dev reads .env.dev, APP_ENV=prod reads .env.prod.
# Real environment variables override the file.
APP_ENV=dev

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TYPESAFE_API_KEY=
# Browser origins allowed to call this API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000,https://irb-watch-frontend.vercel.app
MIN_PASSWORD_LENGTH=8

OPENAI_API_KEY=
# Point at an OpenAI-compatible gateway to control models there. Leave empty for OpenAI direct.
OPENAI_BASE_URL=
# Required for summaries; there is no built-in default. Empty = AI summaries are off.
OPENAI_MODEL=

# Jev (TypeSafe) classifies changes: priority, how substantive, category. Empty key = off.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# AI behaviour. A change is "cosmetic" (template text, no AI summary) when Jev's chance that it
# is substantive is below AI_SKIP_BELOW and Jev is confident it is low priority.
AI_SKIP_BELOW=0.15
AI_MIN_CONFIDENCE=0.6
SUMMARY_REQUESTS_PER_DAY=20

# Server deployment (docker compose, see docs/deploy-ec2.md): the public hostname of the API.
API_DOMAIN=irb-api.warwarsn.online

# Scan schedule: set SCHEDULER_ENABLED=true on the one server that should scan daily.
SCHEDULER_ENABLED=false
SCAN_CRON=0 6 * * *
SCAN_TIMEZONE=Asia/Seoul

# Scan limits
FETCH_RETRY_WAITS_SECONDS=5,15
FETCH_RETRY_BUDGET=10
MAX_SCAN_PAYLOAD_BYTES=20000000

# Where scheduled scans find the hospital login for members-only boards.
#   keyring  = Windows Credential Manager (this PC only)
#   database = encrypted rows in site_credentials (use this on a server, e.g. Render)
CREDENTIAL_STORE=keyring
# Required for CREDENTIAL_STORE=database. Create your own and keep it ONLY in env vars:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes the stored logins unreadable (enter them again). To rotate, put the new
# key first and the old one after it, separated by a comma.
CREDENTIALS_KEY=
# Email through Resend (alarms and the daily scan report for admins). All three must be set
# for mail to be sent; otherwise mail calls do nothing and scans are not affected.
#   RESEND_API_KEY  an API key from your Resend account. Keep it ONLY here or in env vars.
#   MAIL_FROM       a sender on a domain you verified in Resend, for example
#                   IRB Watch <alerts@your-domain>
#   APP_URL         the frontend address, no trailing slash, for the links in the mails
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
ALERT_STALE_HOURS=36
# The daily digest for users (new and updated documents) needs these two as well. The key signs
# the unsubscribe links: any long random string, for example
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it ONLY here or in env vars. API_DOMAIN is the public hostname of this API.
UNSUBSCRIBE_KEY=
DOWNLOAD_LINK_TTL_SECONDS=60
DOWNLOAD_LINKS_PER_DAY=200
MAX_FILE_BYTES=20000000
MAX_DOCS_PER_URL=200
MAX_LLM_CALLS_PER_RUN=100
PER_DOMAIN_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
